<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('checkout.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('common.backHome') %></a></li>
        <li class="breadcrumb-item"><a href="/cart"><%= t('cart.title') %></a></li>
        <li class="breadcrumb-item active"><%= t('checkout.title') %></li>
      </ol>
    </nav>

    <h1 class="page-title"><%= t('checkout.title') %></h1>
    <div class="divider-chinese"></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-error" style="max-width: 820px; margin: 0 auto 20px;"><%= error %></div>
    <% } %>

    <div class="row">
      <div class="col-lg-8">
        <div class="checkout-form" style="background: white; padding: 2.5rem; border-radius: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border: 1px solid var(--border-green);">
          <form action="/checkout" method="post" onsubmit="return validateForm()">
            <h4 style="color: var(--primary-green); margin-bottom: 25px;">
              <span style="border-bottom: 2px solid var(--accent-gold); padding-bottom: 5px;"><%= t('checkout.receiverInfo') %></span>
            </h4>

            <div class="mb-4">
              <label class="form-label"><%= t('checkout.receiverName') %></label>
              <input type="text" class="form-control" name="name" required style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
            </div>

            <div class="mb-4">
              <label class="form-label"><%= t('checkout.receiverPhone') %></label>
              <input type="tel" class="form-control" name="phone" required style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
            </div>

            <div class="mb-4">
              <label class="form-label"><%= t('checkout.receiverAddress') %></label>
              <textarea class="form-control" name="address" rows="3" required style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;"></textarea>
            </div>

            <div class="mb-4">
              <label class="form-label"><%= t('checkout.note') %></label>
              <textarea class="form-control" name="note" rows="2" style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;"></textarea>
            </div>

            <hr style="border-color: var(--border-green); margin: 30px 0;">

            <h4 style="color: var(--primary-green); margin-bottom: 25px;">
              <span style="border-bottom: 2px solid var(--accent-gold); padding-bottom: 5px;"><%= t('checkout.payment') %></span>
            </h4>

            <div class="mb-4">
              <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="payment" id="wechat" value="wechat" checked>
                <label class="form-check-label" for="wechat"><%= t('checkout.paymentWechat') %></label>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="payment" id="alipay" value="alipay">
                <label class="form-check-label" for="alipay"><%= t('checkout.paymentAlipay') %></label>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="payment" id="paypal" value="paypal">
                <label class="form-check-label" for="paypal"><%= t('checkout.paymentPaypal') %></label>
              </div>
            </div>

            <button type="submit" class="btn btn-chinese w-100 py-3" style="font-size: 1.2rem;"><%= t('checkout.submit') %></button>
          </form>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="cart-summary" style="position: sticky; top: 100px;">
          <h4 style="color: var(--primary-green); border-bottom: 2px solid var(--border-green); padding-bottom: 15px; margin-bottom: 20px;">
            <%= t('checkout.orderItems') %>
          </h4>

          <% cart.forEach(function (item) { %>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <span><%= item.name %></span>
              <small class="text-muted d-block">x<%= item.quantity %></small>
            </div>
            <span class="price" data-cny="<%= item.price * item.quantity %>">¥<%= item.price * item.quantity %></span>
          </div>
          <% }); %>

          <hr style="border-color: var(--border-green);">

          <div class="d-flex justify-content-between mb-2">
            <span><%= t('common.goodsTotal') %></span>
            <span class="price" data-cny="<%= total %>">¥<%= total %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span><%= t('common.shipping') %></span>
            <span><%= t('common.freeShipping') %></span>
          </div>

          <hr style="border-color: var(--border-green);">

          <div class="d-flex justify-content-between mb-0">
            <span style="font-weight: 600;"><%= t('checkout.payable') %></span>
            <span style="font-size: 1.5rem; color: var(--accent-gold);" class="price" data-cny="<%= total %>">¥<%= total %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function validateForm() {
      const name = document.querySelector('[name="name"]').value;
      const phone = document.querySelector('[name="phone"]').value;
      const address = document.querySelector('[name="address"]').value;

      if (!name || !phone || !address) {
        alert(<%- JSON.stringify(t('checkout.fillAll')) %>);
        return false;
      }

      return true;
    }
  </script>
</body>
</html>
