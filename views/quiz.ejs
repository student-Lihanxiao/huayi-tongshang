<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('quiz.pageTitle') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <div class="quiz-hero">
      <h1 class="page-title"><%= t('quiz.pageTitle') %></h1>
      <p class="quiz-hero-lead"><%= t('quiz.entryPopupLead') %></p>
      <div class="quiz-hero-tags">
        <span><%= t('quiz.homeEntryHint') %></span>
        <span><%= t('quiz.fullMeta') %></span>
      </div>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-lg-5">
        <div class="quiz-choice quiz-choice-primary">
          <div class="quiz-choice-icon">🧭</div>
          <h2><%= t('quiz.fullTitle') %></h2>
          <p><%= t('quiz.fullLead') %></p>
          <ul class="quiz-choice-meta">
            <li><%= t('quiz.fullMeta') %></li>
          </ul>
          <a href="/quiz/full" class="btn-chinese btn-lg w-100"><%= t('quiz.startFull') %></a>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="quiz-choice">
          <div class="quiz-choice-icon">⚡</div>
          <h2><%= t('quiz.quickTitle') %></h2>
          <p><%= t('quiz.quickLead') %></p>
          <ul class="quiz-choice-meta">
            <li><%= t('quiz.quickMeta') %></li>
          </ul>
          <a href="/quiz/quick" class="btn-chinese btn-lg w-100" style="border-color: var(--accent-gold); color: var(--accent-gold);"><%= t('quiz.startQuick') %></a>
        </div>
      </div>
    </div>

    <div class="quiz-type-strip">
      <h4><%= t('quiz.summaryTitle') %></h4>
      <div class="quiz-type-chips">
        <% (quizDataTypes || []).forEach(function (type) { %>
          <span class="quiz-type-chip" style="border-color: <%= type.color %>; color: <%= type.color %>;">
            <%= type.icon %> <%= loc(type, 'name') %>
          </span>
        <% }); %>
      </div>
    </div>

    <p class="quiz-disclaimer"><%= t('quiz.disclaimer') %></p>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
