<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body class="products-page">
  <%- include('partials/navbar') %>

  <div class="category-header">
    <div class="container">
      <h1><%= pageTitle %></h1>
      <div class="divider-chinese"></div>
      <p class="category-count"><%= t('products.count', { n: total }) %></p>

      <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
        <a href="/products?category=all" class="btn <%= currentCategory === 'all' ? 'btn-chinese' : 'btn-outline-chinese' %>">
          <%= t('products.filterAll') %>
        </a>
        <a href="/products?category=养生" class="btn <%= currentCategory === '养生' ? 'btn-chinese' : 'btn-outline-chinese' %>">
          <%= t('products.categoryHealth') %>
        </a>
        <a href="/products?category=非遗" class="btn <%= currentCategory === '非遗' ? 'btn-chinese' : 'btn-outline-chinese' %>">
          <%= t('products.categoryHeritage') %>
        </a>
        <a href="/products?category=汉服" class="btn <%= currentCategory === '汉服' ? 'btn-chinese' : 'btn-outline-chinese' %>">
          <%= t('products.categoryHanfu') %>
        </a>
      </div>
    </div>
  </div>

  <div class="container my-5">
    <% if (!products || products.length === 0) { %>
      <div class="text-center py-5">
        <p style="color: var(--text-light);"><%= t('common.noProducts') %></p>
      </div>
    <% } else { %>
      <div class="row">
        <% products.forEach(function (product) { %>
        <div class="col-lg-3 col-md-4 col-6 mb-4">
          <div class="card">
            <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>">
            <div class="card-body text-center">
              <span class="heritage-badge"><%= product.heritage %></span>
              <h5 class="card-title"><%= product.name %></h5>
              <p class="price" data-cny="<%= product.price || 0 %>">¥<%= product.price || 0 %></p>
              <a href="/product/<%= product.id %>" class="btn btn-chinese btn-sm"><%= t('common.viewDetail') %></a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
