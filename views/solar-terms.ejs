<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('solar.title') %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('solar.title') %></h1>
    <p class="text-center" style="color: var(--text-light); max-width: 640px; margin: 0 auto 10px;"><%= t('solar.lead') %></p>
    <div class="divider-chinese"></div>

    <div class="solar-term-card">
      <div class="row align-items-center">
        <div class="col-md-6">
          <span class="solar-badge"><%= t('solar.current') %></span>
          <div class="solar-term-name"><%= solarTerm.term %></div>
          <div class="solar-term-date"><%= solarTerm.date %></div>
          <div class="health-tip-box">
            <h5 style="color: var(--primary-green); margin-bottom: 8px;"><%= t('home.todayWellness') %></h5>
            <p><%= solarTerm.healthTips %></p>
          </div>
        </div>
        <div class="col-md-6">
          <div style="background: white; padding: 24px; border-radius: 20px; text-align: center;">
            <h5 style="color: var(--primary-green);"><%= t('solar.next') %></h5>
            <p style="font-size: 1.9rem; color: var(--accent-gold); margin-bottom: 0;"><%= solarTerm.nextTerm %></p>
          </div>
        </div>
      </div>
    </div>

    <h2 class="page-title" style="font-size: 1.7rem;"><%= t('home.solarTitle') %></h2>
    <div class="solar-grid">
      <% (allTerms || []).forEach(function (item) { %>
        <div class="solar-cell<%= item.isCurrent ? ' solar-cell-current' : '' %>">
          <span class="solar-cell-term"><%= item.term %></span>
          <span class="solar-cell-tip"><%= item.tip %></span>
        </div>
      <% }); %>
    </div>

    <div class="text-center mt-5">
      <p style="color: var(--text-light);"><%= t('solar.quizPrompt') %></p>
      <a href="/quiz" class="btn-chinese btn-lg">🧭 <%= t('quiz.homeEntryBtn') %></a>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
