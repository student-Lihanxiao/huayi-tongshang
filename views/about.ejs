<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('about.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
  <style>
    .story-section {
      background: white;
      border-radius: 30px;
      padding: 3rem;
      box-shadow: 0 20px 40px var(--shadow-green);
      margin: 40px 0;
      position: relative;
      overflow: hidden;
    }
    .story-section::before {
      position: absolute;
      bottom: -30px;
      right: -30px;
      font-size: 150px;
      opacity: 0.1;
      color: var(--primary-green);
      transform: rotate(15deg);
    }
    .timeline-item {
      padding-left: 30px;
      border-left: 3px solid var(--border-green);
      margin-bottom: 30px;
      position: relative;
    }
    .timeline-item::before {
      content: '●';
      position: absolute;
      left: -9px;
      top: 0;
      color: var(--accent-gold);
      font-size: 1.2rem;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('about.title') %></h1>
    <div class="divider-chinese"></div>

    <div class="story-section">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h2 style="color: var(--primary-green); font-family: 'KaiTi'; margin-bottom: 20px;"><%= t('about.heading') %></h2>
          <p style="line-height: 1.8; color: var(--text-dark);"><%= t('about.p1') %></p>
          <p style="line-height: 1.8; color: var(--text-dark);"><%= t('about.p2') %></p>
        </div>
      </div>

      <hr style="border-color: var(--border-green); margin: 40px 0;">

      <h3 style="color: var(--primary-green); margin-bottom: 30px;"><%= t('about.timelineTitle') %></h3>
      <% [
        { title: 'about.t1Title', text: 'about.t1Text' },
        { title: 'about.t2Title', text: 'about.t2Text' },
        { title: 'about.t3Title', text: 'about.t3Text' },
        { title: 'about.t4Title', text: 'about.t4Text' }
      ].forEach(function (item) { %>
        <div class="timeline-item">
          <h5 style="color: var(--accent-gold);"><%= t(item.title) %></h5>
          <p><%= t(item.text) %></p>
        </div>
      <% }); %>
    </div>

    <div class="text-center">
      <a href="/quiz" class="btn-chinese btn-lg">🧭 <%= t('quiz.homeEntryBtn') %></a>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
