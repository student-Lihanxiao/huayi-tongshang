<footer class="footer">
  <div class="container">
    <div class="row">
      <div class="col-lg-4 col-md-6 mb-4">
        <h3 class="footer-brand"><%= t('site.name') %></h3>
        <p class="footer-slogan"><%= t('site.slogan') %></p>
        <div class="footer-seal">華遺<br>通商</div>
      </div>

      <div class="col-lg-2 col-md-6 mb-4">
        <h5 class="footer-heading"><%= t('footer.about') %></h5>
        <ul class="footer-list">
          <li><a href="/about"><%= t('footer.about.story') %></a></li>
          <li><a href="/contact"><%= t('footer.about.contact') %></a></li>
          <li><a href="/join"><%= t('footer.about.join') %></a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-6 mb-4">
        <h5 class="footer-heading"><%= t('footer.help') %></h5>
        <ul class="footer-list">
          <li><a href="/faq"><%= t('footer.help.faq') %></a></li>
          <li><a href="/shipping"><%= t('footer.help.shipping') %></a></li>
          <li><a href="/returns"><%= t('footer.help.returns') %></a></li>
        </ul>
      </div>

      <div class="col-lg-4 col-md-6 mb-4">
        <h5 class="footer-heading"><%= t('footer.follow') %></h5>
        <ul class="footer-list">
          <li><a href="#"><%= t('footer.follow.weibo') %></a></li>
          <li><a href="#"><%= t('footer.follow.wechat') %></a></li>
          <li><a href="#"><%= t('footer.follow.xiaohongshu') %></a></li>
        </ul>
        <div class="footer-tags">
          <span>本草</span><span>非遗</span><span>汉服</span><span>手作</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy"><%= t('site.copyright') %></p>
      <p class="footer-note"><%= t('site.demoNotice') %></p>
    </div>
  </div>
</footer>
