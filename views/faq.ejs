<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('faq.title') %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('faq.title') %></h1>
    <div class="divider-chinese"></div>

    <div class="row">
      <div class="col-lg-8 mx-auto">
        <% [
          { q: 'faq.q1', a: 'faq.a1' },
          { q: 'faq.q2', a: 'faq.a2' },
          { q: 'faq.q3', a: 'faq.a3' },
          { q: 'faq.q4', a: 'faq.a4' },
          { q: 'faq.q5', a: 'faq.a5' },
          { q: 'faq.q6', a: 'faq.a6' },
          { q: 'faq.q7', a: 'faq.a7' }
        ].forEach(function (item, index) { %>
          <div class="faq-item<%= index === 0 ? ' active' : '' %>">
            <div class="faq-question" onclick="toggleFaq(this)">
              <span><%= t(item.q) %></span>
              <span class="toggle-icon"><%= index === 0 ? '▲' : '▼' %></span>
            </div>
            <div class="faq-answer"><%= t(item.a) %></div>
          </div>
        <% }); %>
      </div>
    </div>

    <div class="text-center mt-5">
      <a href="/contact" class="btn-chinese"><%= t('contact.title') %></a>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleFaq(element) {
      const item = element.closest('.faq-item');
      item.classList.toggle('active');
      const icon = element.querySelector('.toggle-icon');
      icon.textContent = item.classList.contains('active') ? '▲' : '▼';
    }
  </script>
</body>
</html>
