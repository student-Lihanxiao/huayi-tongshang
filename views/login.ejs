<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 500px; margin: 80px auto;">
    <div style="background: white; padding: 3rem; border-radius: 30px; box-shadow: 0 20px 40px var(--shadow-green); border: 1px solid var(--border-green);">
      <h2 class="text-center" style="color: var(--primary-green); font-family: 'KaiTi'; margin-bottom: 30px;"><%= t('login.title') %></h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <form action="/login" method="post">
        <input type="hidden" name="redirect" value="<%= redirect %>">

        <div class="mb-4">
          <label class="form-label"><%= t('login.username') %></label>
          <input type="text" name="username" class="form-control" required style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
        </div>
        <div class="mb-4">
          <label class="form-label"><%= t('login.password') %></label>
          <input type="password" name="password" class="form-control" required style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
        </div>
        <button type="submit" class="btn btn-chinese w-100 py-3" style="font-size: 1.1rem;"><%= t('login.submit') %></button>
      </form>

      <div class="text-center mt-4">
        <span class="text-muted"><%= t('login.noAccount') %></span>
        <a href="/register?redirect=<%= redirect %>" style="color: var(--primary-green); text-decoration: none;"><%= t('login.goRegister') %></a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
