<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
  <style>
    .product-image {
      border-radius: 30px;
      box-shadow: 0 20px 40px var(--shadow-green);
      max-width: 100%;
    }
    .product-detail-price {
      font-size: 2rem;
      color: var(--accent-gold);
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('product.breadcrumbHome') %></a></li>
        <li class="breadcrumb-item"><a href="/products?category=<%= product.category %>"><%= product.category === '养生' ? t('products.categoryHealth') : product.category === '非遗' ? t('products.categoryHeritage') : t('products.categoryHanfu') %></a></li>
        <li class="breadcrumb-item active"><%= product.name %></li>
      </ol>
    </nav>

    <div class="row g-5">
      <div class="col-md-6">
        <img src="<%= product.image %>" class="product-image img-fluid" alt="<%= product.name %>">
      </div>
      <div class="col-md-6">
        <span class="heritage-badge" style="font-size: 1rem;"><%= product.heritage %></span>
        <h1 style="font-family: 'KaiTi'; color: var(--primary-green); font-size: 2.5rem; margin: 15px 0;"><%= product.name %></h1>
        <p class="product-detail-price price" data-cny="<%= product.price %>">¥<%= product.price %></p>

        <div style="background: var(--light-green); padding: 20px; border-radius: 15px; margin: 25px 0;">
          <p style="margin-bottom: 0; line-height: 1.8;"><%= product.description || t('product.noDescription') %></p>
        </div>

        <form action="/cart/add" method="post">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <div class="d-flex align-items-center gap-3 mb-4">
            <label class="form-label mb-0"><%= t('common.quantity') %></label>
            <div class="quantity-control">
              <button type="button" class="quantity-btn" onclick="decrement()">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" max="10" class="quantity-num" style="width: 70px; border: none; text-align: center;">
              <button type="button" class="quantity-btn" onclick="increment()">+</button>
            </div>
          </div>

          <button type="submit" class="btn btn-chinese btn-lg w-100 py-3" style="font-size: 1.2rem;">
            <%= t('common.addToCart') %>
          </button>
        </form>
      </div>
    </div>

    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="mt-5">
      <h3 class="section-subtitle"><%= t('common.recommend') %></h3>
      <div class="row">
        <% relatedProducts.forEach(function (item) { %>
        <div class="col-md-3">
          <div class="card">
            <img src="<%= item.image %>" class="card-img-top" alt="<%= item.name %>">
            <div class="card-body text-center">
              <h5 class="card-title"><%= item.name %></h5>
              <p class="price" data-cny="<%= item.price %>">¥<%= item.price %></p>
              <a href="/product/<%= item.id %>" class="btn btn-chinese btn-sm"><%= t('common.viewDetail') %></a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function increment() {
      const input = document.getElementById('quantity');
      input.value = parseInt(input.value) + 1;
    }
    function decrement() {
      const input = document.getElementById('quantity');
      if (parseInt(input.value) > 1) {
        input.value = parseInt(input.value) - 1;
      }
    }
  </script>
</body>
</html>
