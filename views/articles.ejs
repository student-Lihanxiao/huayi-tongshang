<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('articles.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('articles.title') %></h1>
    <p class="text-center" style="color: var(--text-light); max-width: 640px; margin: 0 auto 10px;"><%= t('articles.lead') %></p>
    <div class="divider-chinese"></div>

    <% if (!articles || articles.length === 0) { %>
      <div class="text-center py-5">
        <p style="color: var(--text-light);"><%= t('articles.empty') %></p>
      </div>
    <% } else { %>
      <div class="article-grid">
        <% articles.forEach(function (article) { %>
          <div class="article-card">
            <h3><%= article.title %></h3>
            <p><%= article.content ? article.content.substring(0, 80) : t('common.noContent') %>...</p>
            <a href="/article/<%= article.id %>" class="article-link"><%= t('articles.readAll') %></a>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
