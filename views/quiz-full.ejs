<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('quiz.fullTitle') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body class="quiz-page">
  <%- include('partials/navbar') %>

  <div class="container my-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('common.backHome') %></a></li>
        <li class="breadcrumb-item"><a href="/quiz"><%= t('quiz.navTitle') %></a></li>
        <li class="breadcrumb-item active"><%= t('quiz.fullTitle') %></li>
      </ol>
    </nav>

    <div class="quiz-shell">
      <header class="quiz-shell-head">
        <h1><%= t('quiz.fullTitle') %></h1>
        <p><%= t('quiz.fullLead') %></p>
      </header>

      <%
        /* Constitution label map. EJS "with" scope does not reach into closures, so build a plain object here. */
        const typeNameMap = {};
        (allTypes || []).forEach(function (x) { typeNameMap[x.key] = x.icon + ' ' + loc(x, 'name'); });
      %>
      <%- include('partials/quiz-form', {
        mode: 'full',
        items: questions,
        options: options,
        typeNames: typeNameMap
      }) %>
    </div>

    <p class="quiz-disclaimer"><%= t('quiz.disclaimer') %></p>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
