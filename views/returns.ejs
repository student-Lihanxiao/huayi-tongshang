<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('returns.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('returns.title') %></h1>
    <p class="text-center" style="color: var(--text-light); max-width: 640px; margin: 0 auto 10px;"><%= t('returns.lead') %></p>
    <div class="divider-chinese"></div>

    <div class="story-section" style="background: white; border-radius: 30px; padding: 3rem;">
      <div class="row">
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('returns.rule1Title') %></h4>
          <p style="color: var(--text-dark);"><%= t('returns.rule1Text') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('returns.rule2Title') %></h4>
          <p style="color: var(--text-dark);"><%= t('returns.rule2Text') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('returns.rule3Title') %></h4>
          <p style="color: var(--text-dark);"><%= t('returns.rule3Text') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('returns.rule4Title') %></h4>
          <p style="color: var(--text-dark);"><%= t('returns.rule4Text') %></p>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
