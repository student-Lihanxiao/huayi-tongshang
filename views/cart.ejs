<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('cart.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-4">
    <h1 class="page-title"><%= t('cart.title') %></h1>

    <% if (!cart || cart.length === 0) { %>
      <div style="text-align: center; padding: 60px; background: white; border-radius: 30px;">
        <div style="font-size: 4rem; color: var(--border-green);">🛒</div>
        <h3 style="margin: 20px 0;"><%= t('cart.empty') %></h3>
        <a href="/products" class="btn-chinese"><%= t('common.continueShopping') %></a>
      </div>
    <% } else { %>
      <div style="background: white; border-radius: 30px; padding: 30px;">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-green);">
              <th style="padding: 15px; text-align: left;"><%= t('common.product') %></th>
              <th style="padding: 15px;"><%= t('common.price') %></th>
              <th style="padding: 15px;"><%= t('common.quantity') %></th>
              <th style="padding: 15px;"><%= t('common.subtotal') %></th>
              <th style="padding: 15px;"><%= t('common.action') %></th>
            </tr>
          </thead>
          <tbody>
            <% cart.forEach(function (item) { %>
            <tr style="border-bottom: 1px solid var(--border-green);">
              <td style="padding: 15px; display: flex; align-items: center;">
                <img src="<%= item.image %>" style="width: 60px; height: 60px; border-radius: 10px; margin-right: 15px;" alt="<%= item.name %>">
                <span><%= item.name %></span>
              </td>
              <td style="padding: 15px; text-align: center;" class="price" data-cny="<%= item.price %>">¥<%= item.price %></td>
              <td style="padding: 15px; text-align: center;">
                <div style="display: flex; align-items: center; justify-content: center; gap: 10px;">
                  <a href="/cart/update/<%= item.id %>/-1" style="color: var(--primary-green); text-decoration: none;">−</a>
                  <span><%= item.quantity %></span>
                  <a href="/cart/update/<%= item.id %>/1" style="color: var(--primary-green); text-decoration: none;">+</a>
                </div>
              </td>
              <td style="padding: 15px; text-align: center;" class="price" data-cny="<%= item.price * item.quantity %>">¥<%= item.price * item.quantity %></td>
              <td style="padding: 15px; text-align: center;">
                <a href="/cart/remove/<%= item.id %>" style="color: #c62828; text-decoration: none;" onclick="return confirm('<%= t('common.deleteConfirm') %>')"><%= t('common.delete') %></a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>

        <div style="margin-top: 30px; text-align: right;">
          <div style="background: var(--light-green); padding: 20px; border-radius: 20px; display: inline-block; text-align: left;">
            <p><%= t('common.goodsTotal') %><span class="price" data-cny="<%= total %>">¥<%= total %></span></p>
            <p><%= t('common.shipping') %><%= t('common.freeShipping') %></p>
            <p style="font-size: 1.3rem; color: var(--accent-gold);"><%= t('common.total') %><span class="price" data-cny="<%= total %>">¥<%= total %></span></p>
            <div style="margin-top: 20px;">
              <a href="/checkout" class="btn-chinese"><%= t('cart.checkout') %></a>
              <a href="/products" class="btn-chinese" style="margin-left: 10px; border-color: var(--accent-gold); color: var(--accent-gold);"><%= t('common.continueShopping') %></a>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
