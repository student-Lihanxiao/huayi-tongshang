<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('quiz.quickTitle') %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body class="quiz-page">
  <%- include('partials/navbar') %>

  <div class="container my-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('common.backHome') %></a></li>
        <li class="breadcrumb-item"><a href="/quiz"><%= t('quiz.navTitle') %></a></li>
        <li class="breadcrumb-item active"><%= t('quiz.quickTitle') %></li>
      </ol>
    </nav>

    <div class="quiz-shell">
      <header class="quiz-shell-head">
        <h1><%= t('quiz.quickTitle') %></h1>
        <p><%= t('quiz.quickLead') %></p>
      </header>

      <%- include('partials/quiz-form', {
        mode: 'quick',
        items: questions,
        options: options,
        typeNames: null
      }) %>
    </div>

    <div class="quiz-upsell">
      <span><%= t('quiz.entryTryFull') %></span>
      <a href="/quiz/full" class="btn-chinese btn-sm"><%= t('quiz.startFull') %></a>
    </div>

    <p class="quiz-disclaimer"><%= t('quiz.disclaimer') %></p>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
