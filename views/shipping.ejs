<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('shipping.title') %> - <%= t('site.name') %></title>
  <%- include('partials/head-meta') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('shipping.title') %></h1>
    <p class="text-center" style="color: var(--text-light); max-width: 640px; margin: 0 auto 10px;"><%= t('shipping.lead') %></p>
    <div class="divider-chinese"></div>

    <div class="story-section" style="background: white; border-radius: 30px; padding: 3rem;">
      <div class="row">
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('shipping.domesticTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('shipping.domesticText') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('shipping.asiaTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('shipping.asiaText') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('shipping.intlTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('shipping.intlText') %></p>
        </div>
        <div class="col-md-6 mb-4">
          <h4 style="color: var(--primary-green);"><%= t('shipping.noteTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('shipping.noteText') %></p>
        </div>
        <div class="col-12 mt-4">
          <div class="alert" style="background: var(--light-green); border: 1px solid var(--border-green); border-radius: 20px; padding: 20px;">
            <p class="mb-0" style="color: var(--primary-green);"><%= t('shipping.partnerText') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
