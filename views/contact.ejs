<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('contact.title') %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
  <style>
    .contact-card {
      background: white;
      border-radius: 30px;
      padding: 2.5rem;
      box-shadow: 0 20px 40px var(--shadow-green);
      height: 100%;
      text-align: center;
      transition: transform 0.3s;
    }
    .contact-card:hover { transform: translateY(-10px); }
    .contact-icon { font-size: 3rem; color: var(--primary-green); margin-bottom: 20px; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <h1 class="page-title"><%= t('contact.title') %></h1>
    <p class="text-center" style="color: var(--text-light); max-width: 640px; margin: 0 auto 10px;"><%= t('contact.lead') %></p>
    <div class="divider-chinese"></div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="contact-card">
          <div class="contact-icon">📍</div>
          <h4 style="color: var(--primary-green); margin-bottom: 15px;"><%= t('contact.addressTitle') %></h4>
          <p style="color: var(--text-light);"><%- t('contact.addressValue') %></p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="contact-card">
          <div class="contact-icon">📞</div>
          <h4 style="color: var(--primary-green); margin-bottom: 15px;"><%= t('contact.phoneTitle') %></h4>
          <p style="color: var(--text-light);"><%- t('contact.phoneValue') %></p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="contact-card">
          <div class="contact-icon">📧</div>
          <h4 style="color: var(--primary-green); margin-bottom: 15px;"><%= t('contact.emailTitle') %></h4>
          <p style="color: var(--text-light);"><%- t('contact.emailValue') %></p>
        </div>
      </div>
    </div>

    <div class="row mt-4 g-4">
      <div class="col-md-6">
        <div class="story-section" style="background: white; border-radius: 30px; padding: 2.5rem; height: 100%;">
          <h4 style="color: var(--primary-green); margin-bottom: 15px;">🕘 <%= t('contact.serviceTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('contact.serviceText') %></p>
          <h4 style="color: var(--primary-green); margin: 25px 0 15px;">🏛️ <%= t('contact.addressTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('contact.addressText') %></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="story-section" style="background: white; border-radius: 30px; padding: 2.5rem; height: 100%;">
          <h4 style="color: var(--primary-green); margin-bottom: 15px;">🏮 <%= t('contact.coopTitle') %></h4>
          <p style="color: var(--text-dark);"><%= t('contact.coopText') %></p>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-12">
        <div class="story-section" style="background: white; border-radius: 30px; padding: 3rem;">
          <h3 style="color: var(--primary-green); text-align: center; margin-bottom: 30px;"><%= t('contact.formTitle') %></h3>
          <form onsubmit="event.preventDefault(); alert(this.dataset.done);" data-done="<%= t('contact.formSubmit') %>">
            <div class="row">
              <div class="col-md-6 mb-4">
                <input type="text" class="form-control" placeholder="<%= t('contact.formName') %>" style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
              </div>
              <div class="col-md-6 mb-4">
                <input type="email" class="form-control" placeholder="<%= t('contact.formEmail') %>" style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;">
              </div>
              <div class="col-12 mb-4">
                <textarea class="form-control" rows="5" placeholder="<%= t('contact.formMessage') %>" style="border: 1px solid var(--border-green); border-radius: 12px; padding: 12px;"></textarea>
              </div>
              <div class="col-12 text-center">
                <button type="submit" class="btn btn-chinese btn-lg px-5"><%= t('contact.formSubmit') %></button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
