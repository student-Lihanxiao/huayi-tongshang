<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - <%= t('site.name') %></title>
  <%
    /* 取本页已渲染的 <title> 文本，供 head-meta 生成 og:title。
       注意：__output 里的标题已经过 EJS 转义（& 变成 &amp;），
       这里先解码回原始文本，再由 head-meta 统一转义一次，避免双重转义。 */
    const pageTitleFromTag = (() => {
      const html = typeof __output === 'string' ? __output : '';
      const m = html.match(/<title>([\s\S]*?)<\/title>/);
      if (!m) return '';
      return m[1]
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&amp;/g, '&');
    })();
  %>
  <%- include('partials/head-meta', { pageTitleFromTag: pageTitleFromTag }) %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/quiz.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container my-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><%= t('common.backHome') %></a></li>
        <li class="breadcrumb-item"><a href="/articles"><%= t('articles.title') %></a></li>
        <li class="breadcrumb-item active"><%= article.title %></li>
      </ol>
    </nav>

    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="story-section" style="background: white; padding: 3rem; border-radius: 30px;">
          <h1 class="text-center" style="color: var(--primary-green); font-family: 'KaiTi'; margin-bottom: 30px;">
            <%= article.title %>
          </h1>
          <div style="color: var(--text-dark); font-size: 1.1rem; line-height: 1.8;">
            <%= article.content %>
          </div>
          <div class="text-center mt-5">
            <a href="/articles" class="btn btn-chinese"><%= t('common.backList') %></a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
