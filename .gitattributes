# 默认按内容自动判断，不做全局强制
* text=auto

# shell 脚本必须保持 LF：Windows 下若被转成 CRLF，
# Linux 容器会报 "bad interpreter: No such file or directory"
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# 文本文件统一 LF（服务端渲染的模板与样式）
*.js    text eol=lf
*.json  text eol=lf
*.ejs   text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

# 二进制资源不要做任何行尾/编码转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
