# ============================================================
#  华遗通商 · 部署环境变量示例
#  复制为 .env（本地）或在云平台的环境变量面板逐条填写
# ============================================================

# 运行环境：生产环境请设为 production
NODE_ENV=production

# 服务端口。云平台通常会自动注入 PORT，本地默认 3001
PORT=3001

# ★ 必填：会话加密密钥。用于签名登录态，泄露等于任何人可伪造登录。
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=请替换为随机字符串

# ★ 上线必填：站点对外地址（用于 canonical / og:url / sitemap），末尾不要带斜杠
PUBLIC_URL=https://你的域名或平台分配的地址

# 会话 cookie 是否只走 HTTPS。
#   云平台自带 HTTPS  ->  设为 true
#   现场用 http://localhost 演示  ->  必须留空或 false，否则登录与购物车会失效
COOKIE_SECURE=true

# 数据目录。留空则用项目内 data/
#   云平台挂了持久化磁盘 -> 填磁盘挂载路径，例如 /data
#   本地或 VPS（磁盘持久）  -> 留空即可
# DATA_DIR=/data
